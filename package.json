{
  "name": "quillpen",
  "version": "0.5.0",
  "private": true,
  "description": "Anne's Pen: an original open-source word processor with a complete, customizable command library.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/gen-notices.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/run-e2e.mjs smoke",
    "e2e:all": "node scripts/run-e2e.mjs",
    "e2e:smoke": "node scripts/run-e2e.mjs --no-build smoke",
    "e2e:ui-hardening": "node scripts/run-e2e.mjs --no-build ui-hardening",
    "e2e:all-commands": "node scripts/run-e2e.mjs --no-build all-commands",
    "e2e:io": "node scripts/run-e2e.mjs --no-build io",
    "e2e:visual": "node scripts/run-e2e.mjs --no-build visual",
    "e2e:offline": "node scripts/run-e2e.mjs --no-build offline",
    "e2e:ai": "node scripts/run-e2e.mjs --no-build ai",
    "e2e:dictionaries": "node scripts/run-e2e.mjs --no-build dictionaries",
    "e2e:layout": "node tests/e2e/layout.mjs",
    "e2e:legacy": "node scripts/run-e2e.mjs --no-build legacy-open",
    "catalog": "vite-node scripts/gen-catalog.ts",
    "notices": "node scripts/gen-notices.mjs",
    "cap:sync": "npx cap sync android",
    "android:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease",
    "ios:sync": "npm run build && npx cap sync ios",
    "desktop": "npm run build && node scripts/prepare-desktop.mjs && electron build/desktop-app",
    "desktop:dist": "npm run build && node scripts/prepare-desktop.mjs && electron-builder --config electron-builder.config.cjs",
    "icons": "node scripts/gen-android-icons.mjs && node scripts/gen-platform-icons.mjs",
    "e2e:desktop": "npm run build && node scripts/prepare-desktop.mjs && node tests/e2e/desktop.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/caladea": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/cousine": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/gelasio": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/tinos": "^5.3.0",
    "dictionary-en": "^4.0.0",
    "dictionary-en-au": "^3.0.0",
    "dictionary-en-ca": "^3.0.0",
    "dictionary-en-gb": "^3.0.0",
    "hunspell-asm": "^4.0.2",
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "material-symbols": "^0.48.0",
    "nspell": "^2.1.5",
    "prosemirror-changeset": "^2.4.4",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.13",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.5",
    "prosemirror-view": "^1.42.9"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/nspell": "^2.1.6",
    "electron": "^43.8.10",
    "electron-builder": "^26.18.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
